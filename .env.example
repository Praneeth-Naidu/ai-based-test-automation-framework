# Copy to .env and fill in as needed.
#
# Conduit is self-hosted via `docker compose up` (see docker-compose.yml) —
# the public demo.realworld.io / api.realworld.io instances are no longer
# reliably available (see README "Why self-hosted"). These defaults assume
# you're running the stack locally via Docker and executing tests from
# your host machine (not inside the compose network — see the `tests`
# service in docker-compose.yml for the in-network URLs).

# Conduit (RealWorld) app — UI + API under test
CONDUIT_BASE_URL=http://localhost:8092
CONDUIT_API_URL=http://localhost:3000/api

# restful-booker — API under test (has known, documented bugs — see bug-reports/)
BOOKER_API_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# Test execution
HEADLESS=true
